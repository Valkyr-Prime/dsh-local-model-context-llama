{
  "name": "dsh-local-model-context-llama",
  "version": "0.1.1",
  "type": "module",
  "description": "Pick a local model's context size in DSH: lists the models llama.app serves, each supported window with its estimated VRAM, and applies the choice to llama.app (presets, hot reload, unload) and to DSH's contextWindow.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "llama.cpp",
    "llama.app",
    "context-window",
    "vram",
    "local-models"
  ],
  "license": "MIT",
  "author": "Valkyr-Prime",
  "homepage": "https://github.com/Valkyr-Prime/dsh-local-model-context-llama#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Valkyr-Prime/dsh-local-model-context-llama.git"
  },
  "bugs": {
    "url": "https://github.com/Valkyr-Prime/dsh-local-model-context-llama/issues"
  },
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/host.test.mjs && node scripts/client-render.test.mjs"
  }
}
